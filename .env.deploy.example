# Credenciales para scripts/deploy.ps1 (no commitear; copiar a .env.deploy)
DOCKERHUB_USER=puntijhon
DOCKERHUB_TOKEN=dckr_pat_REEMPLAZAR_CON_TU_PAT

# Imagen en DockerHub
BOT_IMAGE=puntijhon/elecciones-bot

# Servidor Ubuntu destino (despliegue remoto)
BOT_SSH_SERVER=192.168.1.93
BOT_SSH_USER=root
BOT_SSH_PASS=
BOT_SSH_HOSTKEY=SHA256:...

# Directorio remoto donde se copia el compose + .env
BOT_SERVER_DIR=/opt/elecciones-bot

# .env de producción a copiar al servidor (ruta local)
BOT_SERVER_ENV=.env.server

# El storage es LOCAL (xlsx + rclone). No se copia JSON de Google:
# en el server, `rclone config` crea el remote "drive" (OAuth cuenta Google)
# y .env.server apunta RCLONE_REMOTE a ese remote.
