# .env.production.example
# Copia a .env.production y rellena con valores reales

# ===== BOT =====
BOT_PORT=8090
NODE_ENV=production
DOMAIN=tudominio.com

# ===== EVOLUTION API =====
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=TU_API_KEY_SEGURA_AQUI
BOT_WEBHOOK_URL=https://tudominio.com/webhook/evolution

# ===== STORAGE =====
SHEET_MODE=local
SHEET_LOCAL_PATH=/app/data/cache/3_PRECONTEO_2022-PLANCHAS.xlsx
RCLONE_REMOTE=drive:elecciones/3_PRECONTEO_2022-PLANCHAS.xlsx

# ===== ADMIN =====
ADMIN_USER=admin
# Genera el hash con: node -e "console.log(require('bcryptjs').hashSync('TU_PASSWORD',8))"
# IMPORTANTE: el hash empieza por $ → envuélvelo en comillas simples para que Docker Compose
# no lo trate como interpolación de variable:  ADMIN_PASS_HASH='$2a$08$...'
ADMIN_PASS_HASH='$2a$08$...'

# ===== EVOLUTION (DB) =====
POSTGRES_USER=evolution
POSTGRES_PASSWORD=password_seguro_aqui
POSTGRES_DB=evolution

# ===== RCLONE =====
RCLONE_REMOTE=drive:elecciones/3_PRECONTEO_2022-PLANCHAS.xlsx

# ===== OPTIONAL =====
CIERRE_HORARIO=17:00
SECCIONALES_VALIDADAS=CHAPARRAL,IBAGUE,VILLARRICA