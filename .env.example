# Configuración del bot de contingencia (copiar a .env y rellenar)
# Puerto del panel web y webhook
BOT_PORT=8090

# Credenciales del panel admin
ADMIN_USER=admin
# Genera el hash con: node -e "console.log(require('bcryptjs').hashSync('TU_PASSWORD',8))"
# IMPORTANTE: el hash empieza por $ → envuélvelo en comillas simples para que Docker Compose
# no lo trate como interpolación de variable:  ADMIN_PASS_HASH='$2a$08$...'
ADMIN_PASS_HASH=''

# Evolution API (instancia por seccional)
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
# URL pública donde Evolution enviará los webhooks (debe apuntar a /webhook/evolution)
BOT_WEBHOOK_URL=http://TU_HOST:8090/webhook/evolution

# Google Sheets (Workspace) — fuente única de catálogo + coordinadores
GOOGLE_CREDENTIALS_JSON=/app/secrets/google-service-account.json
GOOGLE_SHEET_ID=

# (Opcional) refresco desde el app elecciones-fnc
APP_MESAS_URL=

# (Opcional) cierre de jornada en HH:MM (24h). Vacío = sin cierre.
CIERRE_HORARIO=
