# .env de producción para el servidor (copiar a .env.server y rellenar)
# El hash debe ir entre comillas simples por el '$' de bcrypt.
BOT_PORT=8090
ADMIN_USER=admin
ADMIN_PASS_HASH=''

EVOLUTION_API_URL=http://<HOST_EVOLUTION>:8080
EVOLUTION_API_KEY=
BOT_WEBHOOK_URL=http://<HOST_O_LAN_DEL_BOT>:8090/webhook/evolution

# Almacenamiento LOCAL (xlsx + rclone). Sin Google Cloud.
SHEET_MODE=local
SHEET_LOCAL_PATH=/app/data/cache/3_PRECONTEO 2022-PLANCHAS.xlsx
# Remote de rclone apuntando al .xlsx en Drive (vacío = solo local).
# En el server: `rclone config` para crear el remote "drive" (OAuth cuenta Google).
RCLONE_REMOTE=drive:elecciones/3_PRECONTEO 2022-PLANCHAS.xlsx

APP_MESAS_URL=
CIERRE_HORARIO=
